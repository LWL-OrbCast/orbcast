{
  "extends": "./frontend/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-native",
    "noEmit": true
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "frontend/.expo/types/**/*.ts",
    "frontend/expo-env.d.ts"
  ],
  "exclude": [
