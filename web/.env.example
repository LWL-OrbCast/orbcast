# =============================================================================
# HIP-4 web (Vite) — copy to web/.env
# Same Privy App ID as Expo.
# Optional: Web app-client ID from Privy → Configuration → App settings → Clients.
# Do NOT paste the Expo/mobile client ID here — create a second client named Web.
# =============================================================================

VITE_BACKEND_URL=http://localhost:8000
VITE_PRIVY_APP_ID=your-privy-app-id
# VITE_PRIVY_CLIENT_ID=your-web-client-id

# mainnet | testnet (demo)
VITE_HL_NETWORK=mainnet

# Pin builder on orders (same as EXPO_PUBLIC_HL_BUILDER_*). Never take address from API.
# VITE_HL_BUILDER_ADDRESS=0xYourBuilderAddress
# VITE_HL_BUILDER_FEE_TENTHS_BPS=30

# Client Arbitrum reads (wallet USDC balance)
# VITE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
