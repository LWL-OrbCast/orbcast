# =============================================================================
# OrbCast — frontend (Expo)
# Copy:  cp frontend/.env.example frontend/.env
# Or set the same keys as EAS secrets for cloud builds.
# Full reference: docs/ENVIRONMENT.md
# =============================================================================

# --- Required ---
EXPO_PUBLIC_BACKEND_URL=https://your-railway-backend.up.railway.app
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your-privy-mobile-client-id
EXPO_PUBLIC_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- Optional RPCs (banking / testnets) ---
# EXPO_PUBLIC_ARB_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
# EXPO_PUBLIC_MANTLE_RPC_URL=https://mantle-mainnet.g.alchemy.com/v2/YOUR_KEY
# EXPO_PUBLIC_MANTLE_SEPOLIA_RPC_URL=https://mantle-sepolia.g.alchemy.com/v2/YOUR_KEY
# EXPO_PUBLIC_MANTLE_CHAIN_ID=5000
# Source chain for UR digital deposit UI (42161 = Arbitrum One):
# EXPO_PUBLIC_UR_SOURCE_CHAIN_ID=42161

# --- WalletConnect / SIWE (optional â€” external wallet connect) ---
# EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
# EXPO_PUBLIC_SIWE_DOMAIN=your-app-domain.com
# EXPO_PUBLIC_SIWE_URI=https://your-app-domain.com

# --- Branding / attribution (optional) ---
# EXPO_PUBLIC_WHITEPAPER_URL=https://example.com/whitepaper.pdf
# EXPO_PUBLIC_APPSFLYER_DEV_KEY=

# --- Builder fee (forks: set these to earn your own fees) ---
# Orders pin EXPO_PUBLIC_HL_BUILDER_ADDRESS (ignores a mismatched /builder-config address).
# Also set the same values in EAS env for release builds. Match backend BUILDER_ADDRESS.
# Or edit hardcoded defaults — see docs/FORKING.md / docs/HL_BUILDER.md.
# EXPO_PUBLIC_HL_BUILDER_ADDRESS=0xYourBuilderAddress
# EXPO_PUBLIC_HL_BUILDER_FEE_TENTHS_BPS=30

# --- UR test identities (dev only - no committed defaults) ---
# EXPO_PUBLIC_ENABLE_UR_TEST_WALLET_IMPORT=0
# EXPO_PUBLIC_UR_TEST_PRIVY_USER_ID=did:privy:...
# EXPO_PUBLIC_UR_TEST_URID=
# EXPO_PUBLIC_UR_TEST_PRIVY_USER_ID_2=did:privy:...
# EXPO_PUBLIC_UR_TEST_URID_2=

# --- Firebase client files (not EXPO_PUBLIC_*) ---
# Local: copy *.example, then replace with Firebase Console downloads (gitignored).
# EAS cloud: upload the same files as secret FILE vars GOOGLE_SERVICES_PLIST /
# GOOGLE_SERVICES_JSON (not string). See docs/SETUP.md §11.

# =============================================================================
# Do NOT put these on the mobile app
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_URL â€” backend only
# PRIVY_APP_SECRET â€” backend only
# Any relayer / UR / Bridge2 private keys
