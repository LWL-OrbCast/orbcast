{
  "expo": {
    "name": "OrbCast",
    "slug": "prediction-manager",
    "version": "0.1.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "hip4sports",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.hip4sports",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Secure login with Face ID",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera is used to scan QR codes for wallet addresses",
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "rainbow",
          "phantom",
          "cbwallet",
          "zerion"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F5F7F6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.example.hip4sports",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#22C55E"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-appsflyer",
        {}
      ],
      "./plugins/withAppsFlyerManifestFix",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F7F6"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow the app to access your camera to scan QR codes for wallet addresses"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to access your photos so you can set a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#22C55E",
          "sounds": []
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withFirebaseModularHeaders",
      "expo-localization",
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes *Annotation*\n-keepattributes SourceFile,LineNumberTable\n-keep class expo.modules.securestore.** { *; }\n-keep class expo.modules.crypto.** { *; }\n-keep class com.appsflyer.** { *; }\n-keepclassmembers class com.appsflyer.** { *; }\n-keep class kotlin.jvm.internal.** { *; }\n-dontwarn com.appsflyer.**\n-keep class com.google.android.gms.fido.** { *; }\n-keep class androidx.credentials.** { *; }"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8ff5da0-a6a2-4f59-a0bb-99440cb2b3d8"
      }
    }
  }
}
