# =============================================================================
# OrbCast — backend (Railway / local FastAPI)
# Copy:  cp backend/.env.example backend/.env
# Full reference: docs/ENVIRONMENT.md
# NEVER commit .env or private keys.
# =============================================================================

# --- Required (Tier 1 â€” core trading + auth) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase Dashboard â†’ Project Settings â†’ API â†’ "secret" / service_role
# (often shown as sb_secret_â€¦ â€” same value as SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=                          # Privy Dashboard â†’ App settings (JWT / server)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# Comma-separated hot wallets that pay Arbitrum ETH gas for Bridge2 user flows
# (deposit-to-trade, withdraw-to-external). Keep funded; rotate if leaked.
BRIDGE2_RELAYER_PRIVATE_KEY=0x

# --- Builder fee (forks: match frontend EXPO_PUBLIC_HL_BUILDER_*) ---
# Defaults in server.py are the HyperTrade reference builder. Keep BUILDER_ADDRESS
# in sync with EXPO_PUBLIC_HL_BUILDER_ADDRESS (client pins that address on orders).
# Or edit hardcoded defaults - see docs/FORKING.md / docs/HL_BUILDER.md.
# BUILDER_ADDRESS=0xYourBuilderAddress
# BUILDER_FEE=100                            # tenths of a bp (100 = 10 bps = 0.1%)

# --- Bridge2 / Arbitrum (defaults usually fine) ---
# HL_BRIDGE2_ADDRESS=0x2df1c51e09aecf9cacb7bc98cb1742757f163df7
# ARBITRUM_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# ARBITRUM_RPC_URL_FALLBACKS=https://arb1.arbitrum.io/rpc

# --- Demo / HL testnet grants (optional â€” App Review / onboarding sandbox) ---
# Needs testnet USDC on the master wallet so users can claim mock USDC.
# HL_TESTNET_MASTER_PK=0x                   # REQUIRED for demo grants (signs usdSend)
# HL_TESTNET_MASTER_ADDRESS=0x              # optional; derived from PK if omitted
# HL_TESTNET_MASTER_AGENT_PK=0x             # LEGACY â€” not used for grants anymore; safe to omit
# HL_TESTNET_API_URL=https://api.hyperliquid-testnet.xyz
# HL_TESTNET_SIGNATURE_CHAIN_ID=0x66eee
# DEMO_GRANT_AMOUNT_USDC=100
# DEMO_TRANSFER_FEE_USDC=1

# --- Market data (optional â€” features degrade gracefully if unset) ---
# FINNHUB_KEY=
# ALPHAVANTAGE_KEY=
# ALPHA_WARMUP_SECRET=                      # protects /api/alpha/warmup-* admin endpoints
# FOREXRATE_KEY=
# API_SPORTS_KEY=                           # football chrome (EPL fixtures). Server only — never Expo.
# GEMINI_API_KEY=                           # on-demand "Ask AI" asset blurbs in the app

# --- AI copilots control plane (optional â€” Tier 2; same Supabase project as worker) ---
# Must MATCH the AI worker AGENT_KMS_KEY (32-byte hex = 64 hex chars).
# AGENT_KMS_KEY=
# COINGLASS_GLOBAL_MODE=1                   # house CoinGlass key serves all agents (with worker)
# COINGLASS_HOUSE_KEY=                      # used by worker; set here only if you share envs
# SHOWCASE_AGENT_IDS=                       # comma-separated ai_agents.id UUIDs for public showcase API

# --- Neobank / UR banking (optional â€” Tier 3). Skip if you are not shipping banking. ---
# Docs: docs/BANKING_UR.md Â· Partner sandbox: https://partner.ur.app/login?callbackUrl=%2Fapi-sandbox
# UR_ENV=testnet                            # testnet | mainnet
# UR_PARTNER_ID=                            # issued by UR team after approval
# Wallet you choose; UR registers its address when setting up your partner id:
# UR_API_SIGNER_PRIVKEY_TESTNET=0x
# UR_API_SIGNER_PRIVKEY_MAINNET=0x
# UR_EXT_V2_BASE_URL_MAINNET=https://api.ur.app
# Relayers: comma-separated keys that pay Arb ETH / Mantle MNT gas for UR user txs
# (separate from BRIDGE2_RELAYER_* â€” different security domain).
# UR_RELAYER_PRIVKEYS_TESTNET=0xkey1,0xkey2
# UR_RELAYER_PRIVKEYS_MAINNET=0xkey1,0xkey2
# ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
# MANTLE_RPC_URL=https://mantle-mainnet.g.alchemy.com/v2/YOUR_KEY
# MANTLE_MAINNET_RPC_URL=https://mantle-mainnet.g.alchemy.com/v2/YOUR_KEY
# MANTLE_SEPOLIA_RPC_URL=https://mantle-sepolia.g.alchemy.com/v2/YOUR_KEY

# --- UR local / QA only (never needed for a normal fork production deploy) ---
# ENABLE_UR_TEST_WALLET_IMPORT=0
# UR_TEST_OWNER_PRIVKEY_TESTNET=0x
# UR_TEST_OWNER_PRIVKEY_TESTNET_2=0x
# UR_TEST_PRIVY_USER_ID_2=did:privy:...
# UR_TEST_URID=
# UR_TEST_URID_2=
# UR_ENABLE_ONRAMP_SELFTEST=0
# UR_ONRAMP_SELFTEST_SECRET=

# --- Ops / store ---
# APPLE_REVIEW_BYPASS=false                 # true = relax IP geo-fence (e.g. US) for App Review
# ENVIRONMENT=production
# PORT=8000
# Comma-separated extra browser origins for the Vite web app (https://app.example.com)
# CORS_ORIGINS=

# =============================================================================
# Earnings cron (optional ops â€” separate Railway cron-job service)
# =============================================================================
# Backend validates /api/alpha/warmup-earnings with ALPHA_WARMUP_SECRET
# (?secret= query OR Authorization: Bearer).
# Railway cron runner (not FastAPI) typically sets on the cron service:
#   ENDPOINT_URL=https://YOUR_BACKEND/api/alpha/warmup-earnings?secret=...&symbols=TSLA,...
#   CRON_SECRET=<same value as ALPHA_WARMUP_SECRET>
# Those two are NOT read by server.py. FastAPI only needs ALPHA_WARMUP_SECRET.

# =============================================================================
# Safe to OMIT on FastAPI service (not read by server.py)
# =============================================================================
# CRON_SECRET / ENDPOINT_URL  â€” belong on the cron-job service
# FMP_KEY                     â€” unused
# HL_TESTNET_WS_URL           â€” hardcoded in frontend
# EXPO_PUBLIC_*               â€” set on Expo/EAS only
# MONGO_URL / DB_NAME         â€” stub only; Supabase is the database
